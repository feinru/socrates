# Groq API key for the chat agent (https://console.groq.com/keys)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# Groq model with tool calling (default: qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b

# NVD API key to avoid NVD rate limits (optional but highly recommended)
NVD_API_KEY=YOUR_NVD_API_KEY_HERE
# Cap CVE/CPE fetches for quick demos (0 = fetch everything). Ignored by delta syncs.
NVD_MAX_DEMO=0
# On a first run with an existing cache but no sync record, only fetch records
# modified in the last N days (0 = disabled). After one complete fetch, later
# runs sync incrementally from the recorded timestamp automatically.
NVD_DELTA_DAYS=0

# Virtuoso configuration (defaults to 'localhost' for host and 'cskg-sparql' for container)
VIRTUOSO_HOST=localhost
VIRTUOSO_CONTAINER=cskg-sparql


# Optional overrides (defaults work for local runs; Docker Compose sets its own).
# Do NOT point SPARQL_ENDPOINT at the retriever (port 8000) here: the retriever
# reads this file too and would proxy to itself.
# SPARQL_ENDPOINT=http://localhost:8890/sparql
# VECTOR_ENDPOINT=http://localhost:8000/hybrid
# SPARQL_PROXY_TIMEOUT=120
