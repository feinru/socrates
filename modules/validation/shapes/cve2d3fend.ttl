@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix cve: <http://w3id.org/sepses/vocab/ref/cve#> .
@prefix shape: <http://w3id.org/sepses/shape/> .

shape:CVEhasCountermeasureShape
    a sh:NodeShape ;
    sh:targetSubjectsOf cve:hasCountermeasure ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://w3id\\.org/sepses/resource/cve/CVE-[0-9]{4}-[0-9]+$" ;
    sh:property [
        sh:path cve:hasCountermeasure ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:pattern "^http://d3fend\\.mitre\\.org/ontologies/d3fend\\.owl#[A-Za-z0-9_-]+$" ;
        sh:severity sh:Violation ;
        sh:message "cve:hasCountermeasure target must be a D3FEND defensive technique IRI" ;
    ] .
