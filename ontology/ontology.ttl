@prefix socrates:  <http://w3id.org/sepses/ontology/socrates#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

<http://w3id.org/sepses/ontology/socrates>
    a owl:Ontology ;
    rdfs:label "SOCrates Master Ontology"@en ;
    rdfs:comment "Modular master ontology for SOCrates importing core taxonomy, domain classes, relations, and properties."@en ;
    owl:versionInfo "1.0.0" ;
    owl:imports <http://w3id.org/sepses/ontology/socrates/core> ,
                <http://w3id.org/sepses/ontology/socrates/classes> ,
                <http://w3id.org/sepses/ontology/socrates/relations> ,
                <http://w3id.org/sepses/ontology/socrates/properties> .
